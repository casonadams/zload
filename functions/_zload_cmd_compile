_zload_cmd_compile() {
  emulate -L zsh
  setopt null_glob

  local fn_file ret pdir pfile

  print -P "%F{14}zload%f  %F{11}compiling%f        %F{15}%Bbytecode bundle (.zwc)%b%f%F{8}...%f"
  _zload_compile_bundle "$@"
  ret=$?

  if [[ -f "${ZLOAD_HOME}/zload.zsh" ]]; then
    zcompile -R "${ZLOAD_HOME}/zload.zsh" 2>/dev/null
  fi
  if [[ -f "${ZLOAD_HOME}/zload.plugin.zsh" ]]; then
    zcompile -R "${ZLOAD_HOME}/zload.plugin.zsh" 2>/dev/null
  fi

  for fn_file in "${ZLOAD_HOME}/functions"/*(N.); do
    [[ "$fn_file" == *.zwc ]] && continue
    zcompile -R "$fn_file" 2>/dev/null
  done

  for pdir in "${ZLOAD_PLUGINS}"/*(N/); do
    for pfile in "$pdir"/*.(zsh|sh)(N.); do
      [[ "$pfile" == *.zwc ]] && continue
      zcompile -R "$pfile" 2>/dev/null
    done
  done

  if ((ret == 0)); then
    print -P "%F{10}zload%f  %F{10}✓ compiled%f         %F{15}%Bbundle and modules ready%b%f"
  fi
  return $ret
}

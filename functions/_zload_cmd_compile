_zload_cmd_compile() {
  emulate -L zsh

  print -P "%F{14}zload%f  %F{11}compiling%f        %F{15}%Bbytecode bundle (.zwc)%b%f%F{8}...%f"
  _zload_compile_bundle "$@"
  local ret=$?

  _zload_compile_self
  _zload_compile_plugins

  if ((ret == 0)); then
    print -P "%F{10}zload%f  %F{10}✓ compiled%f         %F{15}%Bbundle and modules ready%b%f"
  fi
  return $ret
}

_zload_setup_lazy_compinit() {
  emulate -L zsh
  ((_zload_compinit_done)) && return 0

  if typeset -f _main_complete >/dev/null 2>&1 || typeset -p _comps >/dev/null 2>&1; then
    _zload_compinit_done=1
    _zload_flush_compdefs
    return 0
  fi

  [[ -o interactive ]] || return 0

  local widget
  for widget in complete-word expand-or-complete expand-or-complete-prefix menu-complete menu-expand-or-complete reverse-menu-complete; do
    zle -N "$widget" _zload_lazy_compinit_widget 2>/dev/null
  done
}

_zload_cmd_cd() {
  local target="$1"
  if [[ -z "$target" ]]; then
    print -u2 "Usage: zload cd <plugin>"
    return 1
  fi

  autoload -Uz _zload_cmd_which
  local resolved
  resolved="$(_zload_cmd_which "$target" 2>/dev/null)"

  if [[ -n "$resolved" && -d "$resolved" ]]; then
    cd "$resolved"
    return 0
  elif [[ -n "$resolved" && -f "$resolved" ]]; then
    cd "${resolved:h}"
    return 0
  else
    print -u2 "zload: plugin directory not found: $target"
    return 1
  fi
}

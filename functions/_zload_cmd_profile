_zload_cmd_profile() {
  emulate -L zsh
  zmodload zsh/datetime

  print -P "%F{14}zload profile%f  %F{8}measuring startup latency...%f\n"

  local bundle_file="${ZLOAD_CACHE}/bundle.zsh"
  local bundle_zwc="${bundle_file}.zwc"

  local t0 t1 t_bundle=0.0
  if [[ -f "$bundle_zwc" ]]; then
    t0=$EPOCHREALTIME
    source "$bundle_file"
    t1=$EPOCHREALTIME
    t_bundle=$(((t1 - t0) * 1000))
  fi

  print -P "  %F{14}%BComponent%b%f                          %F{14}%BLatency%b%f     %F{14}%BStatus%b%f"
  print -P "  %F{8}------------------------------------------------------------%f"
  local lat name
  name="Memory-mapped bundle (.zwc)"
  if [[ -f "$bundle_zwc" ]]; then
    printf -v lat "%10.3f ms" "$t_bundle"
    print -P "  ${(r:35:)name} %F{10}${lat}%f   %F{10}active%f"
  else
    print -P "  ${(r:35:)name} %F{8}         N/A%f   %F{8}uncompiled%f"
  fi

  name="Completion system (compinit)"
  if ((_zload_compinit_done)); then
    print -P "  ${(r:35:)name} %F{10}      < 1 ms%f   %F{10}initialized%f"
  else
    print -P "  ${(r:35:)name} %F{8}    0.000 ms%f   %F{8}deferred to <Tab>%f"
  fi

  name="Command stubs (--on)"
  local stub_status="${#_zload_loaded_plugins} registered"
  print -P "  ${(r:35:)name} %F{8}    0.000 ms%f   %F{8}${stub_status}%f"
  print -P "  %F{8}------------------------------------------------------------%f"
  name="Total warm interactive overhead"
  printf -v lat "%10.3f ms" "$t_bundle"
  print -P "  %F{15}%B${(r:35:)name}%b%f %F{10}%B${lat}%b%f\n"

  return 0
}

_zload_cmd_profile() {
  emulate -L zsh
  zmodload zsh/datetime

  print -P "%F{14}zload profile%f  %F{8}measuring startup latency...%f\n"

  local bundle_file="${ZLOAD_CACHE}/bundle.zsh"
  local bundle_zwc="${bundle_file}.zwc"

  local t0 t1 t_bundle=0.0
  if [[ -f "$bundle_zwc" ]]; then
    t0=$EPOCHREALTIME
    source "$bundle_file"
    t1=$EPOCHREALTIME
    t_bundle=$(( (t1 - t0) * 1000 ))
  fi

  print -P "  %F{14}%BComponent%b%f                          %F{14}%BLatency%b%f     %F{14}%BStatus%b%f"
  print -P "  %F{8}------------------------------------------------------------%f"
  if [[ -f "$bundle_zwc" ]]; then
    printf "  %-35s %%F{10}%10.3f ms%%f   %%F{10}active%%f\n" "Memory-mapped bundle (.zwc)" "$t_bundle"
  else
    printf "  %-35s %%F{8}%12s%%f   %%F{8}uncompiled%%f\n" "Memory-mapped bundle (.zwc)" "N/A"
  fi

  if (( _zload_compinit_done )); then
    printf "  %-35s %%F{10}%12s%%f   %%F{10}initialized%%f\n" "Completion system (compinit)" "< 1 ms"
  else
    printf "  %-35s %%F{8}%12s%%f   %%F{8}deferred to <Tab>%%f\n" "Completion system (compinit)" "0.000 ms"
  fi

  printf "  %-35s %%F{8}%12s%%f   %%F{8}%d registered%%f\n" "Command stubs (--on)" "0.000 ms" "${#_zload_loaded_plugins}"
  print -P "  %F{8}------------------------------------------------------------%f"
  printf "  %%F{15}%%B%-35s%%b%%f %%F{10}%%B%10.3f ms%%b%%f\n\n" "Total warm interactive overhead" "$t_bundle"

  return 0
}

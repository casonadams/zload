_zload_cmd_profile() {
  emulate -L zsh
  zmodload zsh/datetime

  print -P "%F{cyan}zload profile: measuring startup latency...%f\n"

  local bundle_file="${ZLOAD_CACHE}/bundle.zsh"
  local bundle_zwc="${bundle_file}.zwc"

  local t0 t1 t_bundle=0.0
  if [[ -f "$bundle_zwc" ]]; then
    t0=$EPOCHREALTIME
    source "$bundle_file"
    t1=$EPOCHREALTIME
    t_bundle=$(( (t1 - t0) * 1000 ))
  fi

  printf "%-35s %12s   %s\n" "Component" "Latency" "Status"
  print "------------------------------------------------------------------"
  if [[ -f "$bundle_zwc" ]]; then
    printf "%-35s %10.3f ms   %s\n" "Memory-mapped bundle (.zwc)" "$t_bundle" "active"
  else
    printf "%-35s %12s   %s\n" "Memory-mapped bundle (.zwc)" "N/A" "uncompiled"
  fi

  if (( _zload_compinit_done )); then
    printf "%-35s %12s   %s\n" "Completion system (compinit)" "< 1 ms" "initialized"
  else
    printf "%-35s %12s   %s\n" "Completion system (compinit)" "0.000 ms" "deferred to <Tab>"
  fi

  printf "%-35s %12s   %d registered\n" "Command stubs (--on)" "0.000 ms" "${#_zload_loaded_plugins}"
  print "------------------------------------------------------------------"
  printf "%-35s %10.3f ms\n" "Total warm interactive overhead" "$t_bundle"

  return 0
}

_zload_cmd_which() {
  emulate -L zsh
  setopt null_glob

  local target="$1"
  if [[ -z "$target" ]]; then
    print -u2 "Usage: zload which <plugin>"
    return 1
  fi

  local -A parsed
  _zload_parse_spec parsed "$target"

  local check_dir="${parsed[dir]}"
  [[ -n "${parsed[subpath]}" ]] && check_dir="${check_dir}/${parsed[subpath]}"

  if [[ -d "$check_dir" || -f "$check_dir" ]]; then
    print "${check_dir:A}"
    return 0
  fi

  local d
  for d in "${ZLOAD_PLUGINS}"/*(N/); do
    local base="${d:t}"
    if [[ "$base" == "$target" || "$base" == *---"$target" ]]; then
      print "${d:A}"
      return 0
    fi
  done

  print -u2 "zload: plugin not found: $target"
  return 1
}

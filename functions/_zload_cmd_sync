_zload_cmd_sync() {
  emulate -L zsh

  local lock_file="${1:-${ZLOAD_DATA}/zload.lock}"
  if [[ ! -f "$lock_file" ]]; then
    print -u2 -P "%F{9}zload: lockfile not found: $lock_file%f"
    return 1
  fi

  print -P "%F{14}zload%f  %F{8}syncing plugins from ${lock_file}...%f\n"

  local -A idx parsed
  _zload_index_specs idx

  integer synced=0 failed=0
  local line name commit dir curr url
  for line in "${(f)"$(<"$lock_file")"}"; do
    [[ -z "$line" || "$line" == \#* ]] && continue

    name="${line%%:*}"
    commit="${line#*:}"
    dir="${ZLOAD_PLUGINS}/${name}"

    if [[ "$name" == */* || "$name" == .* ]]; then
      _zload_row 9 "✗" "$name" 9 "invalid name in lockfile"
      ((failed++))
      continue
    fi

    if [[ ! -d "$dir/.git" ]]; then
      url=""
      if ((${+idx[$dir]})); then
        _zload_parse_spec parsed "${idx[$dir]}"
        url="${parsed[url]}"
      fi
      if [[ -z "$url" ]]; then
        _zload_row 11 "•" "$name" 11 "not installed and not declared (skipping)"
        continue
      fi
      mkdir -p "${dir:h}"
      command git init -q "$dir" 2>/dev/null && command git -C "$dir" remote add origin "$url" 2>/dev/null
    fi

    curr="$(command git -C "$dir" rev-parse HEAD 2>/dev/null)"
    if [[ "$curr" == "$commit" ]]; then
      _zload_row 12 "•" "$name" 8 "already at locked commit"
      continue
    fi

    if ! command git -C "$dir" checkout -q "$commit" 2>/dev/null; then
      command git -C "$dir" fetch -q --depth 1 origin "$commit" 2>/dev/null &&
        command git -C "$dir" checkout -q "$commit" 2>/dev/null
    fi
    if [[ "$(command git -C "$dir" rev-parse HEAD 2>/dev/null)" != "$commit" ]]; then
      _zload_row 9 "✗" "$name" 9 "could not check out ${commit[1,8]}"
      ((failed++))
      continue
    fi

    _zload_row 10 "✓" "$name" 10 "synced" "${commit[1,8]}"
    ((synced++))
    if ((${+idx[$dir]})); then
      _zload_parse_spec parsed "${idx[$dir]}"
      if [[ -n "${parsed[build_cmd]}" ]]; then
        print -P "     %F{14}zload%f  %F{11}rebuilding%f  %F{15}%B${name}%b%f %F{8}(${parsed[build_cmd]})%f"
        _zload_run_build "$dir" "${parsed[subpath]}" "${parsed[build_cmd]}" "$name" || ((failed++))
      fi
    fi
  done

  if ((synced > 0)) && [[ -d "$ZLOAD_CACHE" ]]; then
    rm -f "${ZLOAD_CACHE}"/zcompdump*(N)
  fi

  _zload_compile_bundle
  if ((failed > 0)); then
    print -u2 -P "\n%F{9}zload%f  %F{9}sync finished with ${failed} failure(s)%f %F{8}($synced plugins updated)%f"
    return 1
  fi
  print -P "\n%F{10}zload%f  %F{10}✓ sync complete%f %F{8}($synced plugins updated)%f"
  return 0
}

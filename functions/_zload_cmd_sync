_zload_cmd_sync() {
  emulate -L zsh

  local lock_file="${1:-${ZLOAD_DATA}/zload.lock}"
  if [[ ! -f "$lock_file" ]]; then
    print -u2 -P "%F{9}zload: lockfile not found: $lock_file%f"
    return 1
  fi

  print -P "%F{14}zload%f  %F{8}syncing plugins from ${lock_file}...%f\n"

  integer synced=0
  local line
  for line in "${(f)"$(< "$lock_file")"}"; do
    [[ -z "$line" || "$line" == \#* ]] && continue

    local name="${line%%:*}"
    local commit="${line#*:}"
    local dir="${ZLOAD_PLUGINS}/${name}"

    if [[ -d "$dir/.git" ]]; then
      local curr
      curr="$(command git -C "$dir" rev-parse HEAD 2>/dev/null)"
      if [[ "$curr" != "$commit" ]]; then
        command git -C "$dir" checkout -q "$commit" 2>/dev/null || {
          command git -C "$dir" fetch -q origin 2>/dev/null || true
          command git -C "$dir" checkout -q "$commit" 2>/dev/null || true
        }
        print -P "  %F{10}✓%f  %F{15}%B${(r:35:)name}%b%f  %F{10}synced%f  %F{8}(${commit[1,8]})%f"
        (( synced++ ))
      else
        print -P "  %F{12}•%f  %F{15}%B${(r:35:)name}%b%f  %F{8}already at locked commit%f"
      fi
    fi
  done

  _zload_compile_bundle
  print -P "\n%F{10}zload%f  %F{10}✓ sync complete%f %F{8}($synced plugins updated)%f"
  return 0
}

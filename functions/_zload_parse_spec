_zload_parse_spec() {
  emulate -L zsh
  setopt extended_glob

  local out_var="$1"
  shift

  local -A _zparsed=(
    raw "$*" spec "" name "" type "" url "" ref "" dir "" subpath ""
    on_cmds "" defer 0 bin "" build_cmd "" on_dir "" from "" sha256 ""
  )
  local -A optmap=(
    --on on_cmds --bin bin --path subpath --subpath subpath
    --build build_cmd --hook build_cmd --on-dir on_dir --from from --sha256 sha256
  )

  local -a words
  words=("${(@Q)${(z)${*}}}")

  local _zspec_val="${words[1]}"
  _zparsed[spec]="$_zspec_val"

  integer idx=2
  while ((idx <= ${#words})); do
    if ((${+optmap[${words[idx]}]})); then
      _zparsed[${optmap[${words[idx]}]}]="${words[idx + 1]}"
      ((idx++))
    elif [[ "${words[idx]}" == --(defer|idle) ]]; then
      _zparsed[defer]=1
    fi
    ((idx++))
  done
  _zparsed[sha256]="${(L)_zparsed[sha256]}"

  local base="$_zspec_val" ref_val="" rest_val="${_zspec_val#git@}"
  if [[ "$_zspec_val" == git@* ]]; then
    base="git@${rest_val%%[@#]*}"
  else
    base="${_zspec_val%%[@#]*}"
  fi
  if [[ "$rest_val" == *@* ]]; then
    ref_val="${rest_val#*@}"
  elif [[ "$rest_val" == *[\#]* ]]; then
    ref_val="${rest_val#*[\#]}"
  fi

  _zload_spec_source "$_zspec_val" "$base" "$ref_val" "${_zparsed[from]}"
  _zparsed+=("${reply[@]}")

  typeset -g -A "$out_var"
  set -A "$out_var" "${(@kv)_zparsed}"
}

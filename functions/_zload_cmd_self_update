_zload_cmd_self_update() {
  emulate -L zsh
  setopt null_glob

  local old_commit new_commit fn_file fn force=0 arg pull_err line
  for arg in "$@"; do
    [[ "$arg" == "-f" || "$arg" == "--force" ]] && force=1
  done

  if [[ ! -d "${ZLOAD_HOME}/.git" ]]; then
    print -u2 -P "%F{11}zload: self-update requires a Git installation in %B${ZLOAD_HOME}%b%f"
    return 1
  fi

  print -P "%F{14}zload%f  %F{8}upgrading zload itself in %B${ZLOAD_HOME}%b...%f\n"

  old_commit="$(command git -C "$ZLOAD_HOME" rev-parse --short HEAD 2>/dev/null)"

  if (( force )); then
    command git -C "$ZLOAD_HOME" reset --hard HEAD >/dev/null 2>&1
    command git -C "$ZLOAD_HOME" clean -df >/dev/null 2>&1
  fi

  if ! pull_err="$(command git -C "$ZLOAD_HOME" pull --ff-only 2>&1)"; then
    print -u2 -P "%F{9}zload: failed to pull latest changes for zload%f"
    for line in "${(@f)pull_err}"; do
      [[ -n "$line" ]] && print -u2 -P "  %F{8}${line}%f"
    done
    return 1
  fi
  new_commit="$(command git -C "$ZLOAD_HOME" rev-parse --short HEAD 2>/dev/null)"

  rm -f "${ZLOAD_HOME}"/*.zwc(N) "${ZLOAD_HOME}/functions"/*.zwc(N)

  if [[ -f "${ZLOAD_HOME}/zload.zsh" ]]; then
    zcompile -R "${ZLOAD_HOME}/zload.zsh" 2>/dev/null
  fi
  if [[ -f "${ZLOAD_HOME}/zload.plugin.zsh" ]]; then
    zcompile -R "${ZLOAD_HOME}/zload.plugin.zsh" 2>/dev/null
  fi

  for fn_file in "${ZLOAD_HOME}/functions"/*(N.); do
    [[ "$fn_file" == *.zwc ]] && continue
    zcompile -R "$fn_file" 2>/dev/null
  done

  if [[ -d "$ZLOAD_CACHE" ]]; then
    rm -rf "${ZLOAD_CACHE}"/*(ND)
  fi

  for fn in "${ZLOAD_HOME}/functions"/_zload*(N:t); do
    [[ "$fn" == *.zwc ]] && continue
    unfunction "$fn" 2>/dev/null
    autoload -Uz "$fn"
  done

  source "${ZLOAD_HOME}/zload.zsh"

  if [[ "$old_commit" == "$new_commit" ]]; then
    print -P "  %F{10}✓%f  %F{15}%Bzload%b%f  %F{10}recompiled and up to date%f  %F{8}(${new_commit})%f\n"
  else
    print -P "  %F{10}✓%f  %F{15}%Bzload%b%f  %F{10}upgraded and recompiled%f  %F{8}(${old_commit} -> ${new_commit})%f\n"
  fi

  return 0
}

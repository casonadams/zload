_zload_doctor_cache() {
  emulate -L zsh
  setopt null_glob

  local do_fix="$1" bundle_file dump_file
  local -a bundles
  bundles=("${ZLOAD_CACHE}"/bundle*.zsh(N.))

  if ((${#bundles} == 0)); then
    print -P "  %F{8}[INFO]%f  Bundle: not yet generated (will compile on cold startup)"
  fi
  for bundle_file in "${bundles[@]}"; do
    if [[ -f "${bundle_file}.zwc" ]]; then
      print -P "  %F{10}[OK]%f    Bytecode bundle: %F{15}%B${bundle_file}.zwc%b%f %F{8}(compiled)%f"
    elif ((do_fix)); then
      zcompile -R "$bundle_file" 2>/dev/null
      print -P "  %F{10}[FIXED]%f Bytecode bundle: compiled %F{15}%B${bundle_file}.zwc%b%f"
    else
      print -P "  %F{11}[WARN]%f  Bundle: %F{15}%B$bundle_file%b%f exists but .zwc wordcode is missing"
      ((_zload_doctor_warnings++))
    fi
  done

  dump_file="${ZLOAD_CACHE}/zcompdump-${ZSH_VERSION}"
  if [[ -f "${dump_file}.zwc" ]]; then
    print -P "  %F{10}[OK]%f    Completion cache: %F{15}%B${dump_file}.zwc%b%f %F{8}(compiled)%f"
  elif [[ ! -f "$dump_file" ]]; then
    print -P "  %F{8}[INFO]%f  Completion dump: deferred (will compile on first Tab)"
  elif ((do_fix)); then
    zcompile -R "$dump_file" 2>/dev/null
    print -P "  %F{10}[FIXED]%f Completion dump: compiled %F{15}%B${dump_file}.zwc%b%f"
  else
    print -P "  %F{10}[OK]%f    Completion dump: %F{15}%B$dump_file%b%f"
  fi

  if ((do_fix)) && [[ -f "${ZLOAD_HOME}/zload.zsh" && ! -f "${ZLOAD_HOME}/zload.zsh.zwc" ]]; then
    zcompile -R "${ZLOAD_HOME}/zload.zsh" 2>/dev/null
    print -P "  %F{10}[FIXED]%f Core module: compiled %F{15}%B${ZLOAD_HOME}/zload.zsh.zwc%b%f"
  fi
}

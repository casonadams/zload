_zload_load_plugin() {
  local in_var="$1"
  local -A _zspec
  _zspec=("${(@Pkv)in_var}")

  local target_dir="${_zspec[dir]}"
  if [[ -n "${_zspec[subpath]}" ]]; then
    target_dir="${target_dir}/${_zspec[subpath]}"
  fi

  local plugin_name="${_zspec[subpath]:t}"
  [[ -z "$plugin_name" ]] && plugin_name="${_zspec[name]}"

  local -A _zinfo
  if [[ -f "${target_dir}" ]]; then
    _zinfo[script]="${target_dir}"
  elif [[ -f "${target_dir}.zsh-theme" ]]; then
    _zinfo[script]="${target_dir}.zsh-theme"
  else
    _zload_find_main_file _zinfo "$target_dir" "$plugin_name"
  fi

  # Prezto functions autoloading
  if [[ "${_zspec[type]}" == "prezto" && -d "$target_dir/functions" ]]; then
    local -a funcs
    funcs=("$target_dir/functions"/*(N:t))
    if ((${#funcs} > 0)); then
      fpath=("$target_dir/functions" "${fpath[@]}")
      autoload -Uz "${funcs[@]}"
    fi
  fi

  if [[ -n "${_zinfo[fpath]}" ]]; then
    local -a fps
    fps=("${(s.:.)_zinfo[fpath]}")
    for fp in "${fps[@]}"; do
      if [[ -d "$fp" ]] && ((! ${fpath[(Ie)$fp]})); then
        fpath=("$fp" "${fpath[@]}")
      fi
    done
  fi

  local bin_dir="${_zinfo[bin]}"
  if [[ -n "${_zspec[bin]}" ]]; then
    bin_dir="${_zspec[dir]}/${_zspec[bin]}"
  fi
  if [[ -n "$bin_dir" && -d "$bin_dir" ]]; then
    if ((! ${path[(Ie)$bin_dir]})); then
      path=("$bin_dir" "${path[@]}")
    fi
  fi

  if [[ -n "${_zspec[on_cmds]}" ]]; then
    _zload_create_stub "${_zspec[on_cmds]}" "${_zinfo[script]}" "${_zspec[type]}" "${_zspec[subpath]}"
    _zload_loaded_plugins["${_zspec[raw]}"]="stubbed"
    return 0
  fi

  if [[ "${_zspec[type]}" == "omz" ]]; then
    _zload_omz_shim "${_zspec[subpath]}" "${_zinfo[script]}"
  fi

  if [[ -n "${_zinfo[script]}" && -f "${_zinfo[script]}" ]]; then
    source "${_zinfo[script]}"
    _zload_loaded_plugins["${_zspec[raw]}"]="loaded"
  fi

  return 0
}

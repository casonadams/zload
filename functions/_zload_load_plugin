_zload_load_plugin() {
  local in_var="$1"
  local -A _zspec
  _zspec=("${(@Pkv)in_var}")

  local -A _zinfo
  _zload_resolve_plugin _zspec _zinfo

  _zload_activate_dirs _zspec _zinfo

  if [[ -n "${_zspec[on_cmds]}" ]]; then
    _zload_create_stub "${_zspec[on_cmds]}" "${_zinfo[script]}" "${_zspec[type]}" "${_zspec[subpath]}"
    _zload_loaded_plugins["${_zspec[raw]}"]="stubbed"
    return 0
  fi

  if [[ "${_zspec[type]}" == "omz" ]]; then
    _zload_omz_shim "${_zspec[subpath]}" "${_zinfo[script]}"
  fi

  if [[ -n "${_zinfo[script]}" && -f "${_zinfo[script]}" ]]; then
    source "${_zinfo[script]}"
    _zload_loaded_plugins["${_zspec[raw]}"]="loaded"
  fi

  return 0
}

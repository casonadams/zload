_zload_compile_bundle() {
  emulate -L zsh

  if (($# > 0)); then
    _zload_write_bundle 1 "$@"
    return $?
  fi

  local slot
  if ((${#_zload_call_entries} > 0)); then
    for slot in "${(@kon)_zload_call_entries}"; do
      _zload_write_bundle "$slot" "${(@f)_zload_call_entries[$slot]}"
    done
  elif ((${#_zload_specs} > 0)); then
    _zload_write_bundle 1 "${_zload_specs[@]}"
  fi
  return 0
}

_zload_cmd_list() {
  emulate -L zsh
  setopt null_glob

  print -P "%F{14}zload%f  %F{8}installed plugins in ${ZLOAD_PLUGINS}:%f\n"

  local -a plugin_dirs
  plugin_dirs=("${ZLOAD_PLUGINS}"/*(N/))

  if ((${#plugin_dirs} == 0)); then
    print -P "  %F{8}(no plugins installed)%f"
    return 0
  fi

  local dir name commit ref
  for dir in "${plugin_dirs[@]}"; do
    name="${dir:t}"
    if [[ "$name" == "_snippets" ]]; then
      continue
    fi
    if [[ -d "$dir/.git" ]]; then
      commit="$(command git -C "$dir" rev-parse --short HEAD 2>/dev/null)"
      ref="$(command git -C "$dir" describe --tags --exact-match 2>/dev/null || command git -C "$dir" branch --show-current 2>/dev/null)"
      [[ -z "$ref" ]] && ref="pinned"
      print -P "  %F{10}●%f  %F{15}%B${(r:35:)name}%b%f %F{8}(${ref}@${commit})%f"
    else
      print -P "  %F{12}●%f  %F{15}%B${(r:35:)name}%b%f %F{8}(local)%f"
    fi
  done
  print ""
  return 0
}

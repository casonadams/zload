_zload_eval() {
  emulate -L zsh

  local name="$1"
  shift
  local cmd="$*"

  if [[ -z "$name" || -z "$cmd" ]]; then
    print -u2 "Usage: zload eval <name> <command>"
    return 1
  fi

  local eval_dir="${ZLOAD_CACHE}/eval"
  mkdir -p "$eval_dir"
  local cache_file="${eval_dir}/${name}.zsh"
  local zwc_file="${cache_file}.zwc"

  local bin_name="${cmd[(w)1]}"
  local bin_path="${commands[$bin_name]}"

  local need_rebuild=0
  if [[ ! -f "$zwc_file" || ! -f "$cache_file" ]]; then
    need_rebuild=1
  elif [[ -n "$bin_path" && -f "$bin_path" && "$bin_path" -nt "$cache_file" ]]; then
    need_rebuild=1
  fi

  if ((need_rebuild)); then
    eval "$cmd" >"$cache_file" 2>/dev/null
    zcompile -R "$cache_file" 2>/dev/null
  fi

  source "$cache_file"
}

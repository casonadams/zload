_zload_omz_shim() {
  emulate -L zsh

  typeset -g -A _zload_omz_loaded_libs

  local subpath="$1"
  local script_file="$2"
  local omz_lib="${ZLOAD_PLUGINS}/_omz/lib"
  [[ ! -d "$omz_lib" && -d "${ZSH}/lib" ]] && omz_lib="${ZSH}/lib"
  [[ ! -d "$omz_lib" ]] && return 0

  local -A libfile=(git git.zsh theme theme-and-appearance.zsh termsupport termsupport.zsh)
  local lib
  _zload_omz_libs "$subpath" "$script_file"
  for lib in "${reply[@]}"; do
    ((${_zload_omz_loaded_libs[$lib]:-0})) && continue
    [[ -f "$omz_lib/${libfile[$lib]}" ]] || continue
    source "$omz_lib/${libfile[$lib]}"
    _zload_omz_loaded_libs[$lib]=1
  done

  return 0
}

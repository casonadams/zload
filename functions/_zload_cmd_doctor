_zload_cmd_doctor() {
  emulate -L zsh

  local do_fix=0
  [[ "$1" == "--fix" ]] && do_fix=1

  print -P "%F{14}zload doctor%f  %F{8}running environment diagnostics...%f\n"
  typeset -g -i _zload_doctor_errors=0 _zload_doctor_warnings=0
  _zload_doctor_env "$do_fix"
  _zload_doctor_cache "$do_fix"

  local errors=$_zload_doctor_errors warnings=$_zload_doctor_warnings
  unset _zload_doctor_errors _zload_doctor_warnings

  print ""
  if ((errors > 0)); then
    print -P "%F{9}zload doctor%f  %F{9}✗ found $errors error(s) and $warnings warning(s)%f"
    return 1
  elif ((warnings > 0)); then
    print -P "%F{11}zload doctor%f  %F{11}⚠ found $warnings warning(s), core features operational%f"
  else
    print -P "%F{10}zload doctor%f  %F{10}✓ all checks passed! System is healthy and optimized.%f"
  fi
  return 0
}

_zload_cmd_update() {
  emulate -L zsh
  setopt local_options null_glob no_monitor no_notify extended_glob

  print -P "%F{14}zload%f  %F{8}updating installed plugins...%f\n"

  local -a plugin_dirs
  plugin_dirs=("${ZLOAD_PLUGINS}"/*(N/))

  if ((${#plugin_dirs} == 0)); then
    print -P "  %F{8}(no plugins installed)%f"
    return 0
  fi

  local -A job_pids old_commits idx parsed
  local -a failed
  integer updated_count=0 force=0
  local dir name branch pid ref commit arg

  for arg in "$@"; do
    [[ "$arg" == "-f" || "$arg" == "--force" ]] && force=1
  done

  _zload_index_specs idx

  for dir in "${plugin_dirs[@]}"; do
    name="${dir:t}"
    [[ "$name" == "_snippets" ]] && continue

    if [[ ! -d "$dir/.git" ]]; then
      ((${+idx[$dir]})) && _zload_parse_spec parsed "${idx[$dir]}"
      if ((${+idx[$dir]})) && [[ "${parsed[type]}" == "gh-r" ]]; then
        _zload_update_gh_r "${idx[$dir]}" "$name" || failed+=("$name")
      else
        _zload_row 12 "•" "$name" 8 "(local plugin, skipping)"
      fi
      continue
    fi

    branch="$(command git -C "$dir" branch --show-current 2>/dev/null)"
    if [[ -z "$branch" ]]; then
      _zload_row 11 "•" "$name" 11 "pinned ref (skipping)"
      continue
    fi

    old_commits[$dir]="$(command git -C "$dir" rev-parse --short HEAD 2>/dev/null)"

    (
      if ((force)); then
        command git -C "$dir" reset --hard HEAD >/dev/null 2>&1
        command git -C "$dir" clean -df >/dev/null 2>&1
      fi
      command git -C "$dir" pull --ff-only >/dev/null 2>&1
    ) &
    job_pids[$dir]="$!"
  done

  for dir in "${plugin_dirs[@]}"; do
    ((! $+job_pids[$dir])) && continue
    pid="${job_pids[$dir]}"
    name="${dir:t}"

    if ! wait "$pid"; then
      _zload_row 9 "✗" "$name" 9 "update failed"
      failed+=("$name")
      continue
    fi

    commit="$(command git -C "$dir" rev-parse --short HEAD 2>/dev/null)"
    ref="$(command git -C "$dir" branch --show-current 2>/dev/null)"
    [[ -z "$ref" ]] && ref="pinned"
    if [[ -z "${old_commits[$dir]}" || "${old_commits[$dir]}" == "$commit" ]]; then
      _zload_row 10 "✓" "$name" 10 "up to date" "${ref}@${commit}"
      continue
    fi

    _zload_row 10 "✓" "$name" 10 "updated" "${old_commits[$dir]} -> ${commit}"
    ((updated_count++))
    _zload_parse_spec parsed "${idx[$dir]}"
    if [[ -n "${parsed[build_cmd]}" ]]; then
      print -P "     %F{14}zload%f  %F{11}rebuilding%f  %F{15}%B${name}%b%f %F{8}(${parsed[build_cmd]})%f"
      _zload_run_build "$dir" "${parsed[subpath]}" "${parsed[build_cmd]}" "$name" || failed+=("$name")
    fi
  done

  _zload_update_snippets idx
  updated_count+=${reply[1]}
  failed+=("${(@)reply[2,-1]}")

  if ((updated_count > 0)) && [[ -d "$ZLOAD_CACHE" ]]; then
    rm -f "${ZLOAD_CACHE}"/zcompdump*(N)
  fi

  if ((${#failed} > 0)); then
    print -u2 -P "\n%F{11}zload:%f %F{11}warning: some plugins failed to update%f"
  fi

  _zload_compile_bundle
  ((updated_count > 0)) && _zload_compile_plugins
  print -P "\n%F{10}zload%f  %F{10}✓ update complete and bundle recompiled.%f"
  return 0
}

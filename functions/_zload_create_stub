_zload_create_stub() {
  emulate -L zsh

  local raw_cmds="$1"
  local script_path="$2"
  local plugin_type="$3"
  local subpath="$4"
  local emit_mode=0
  [[ "$5" == "--emit" ]] && emit_mode=1

  local -a cmds clean_cmds
  cmds=("${(s:,:)raw_cmds}")
  for cmd in "${cmds[@]}"; do
    cmd="${cmd//[[:space:]]/}"
    [[ -n "$cmd" ]] && clean_cmds+=("$cmd")
  done

  for cmd in "${clean_cmds[@]}"; do
    local fn_code="
      ${cmd}() {
        for c in ${(j: :)clean_cmds}; do
          unfunction \"\$c\" 2>/dev/null
        done
        if [[ ${(q)plugin_type} == 'omz' ]]; then
          _zload_omz_shim ${(q)subpath} ${(q)script_path}
        fi
        if [[ -n ${(q)script_path} && -f ${(q)script_path} ]]; then
          source ${(q)script_path}
        fi
        if typeset -f \"\$0\" >/dev/null 2>&1; then
          \"\$0\" \"\$@\"
        elif alias \"\$0\" >/dev/null 2>&1; then
          eval \"\$0 \\\"\\\$@\\\"\"
        elif (( \$+commands[\$0] )); then
          command \"\$0\" \"\$@\"
        else
          eval \"\$0 \\\"\\\$@\\\"\"
        fi
      }
    "
    if ((emit_mode)); then
      print -r -- "$fn_code"
    else
      eval "$fn_code"
    fi
  done
}

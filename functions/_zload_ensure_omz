_zload_ensure_omz() {
  emulate -L zsh

  local omz_dir="${ZLOAD_PLUGINS}/_omz"
  export ZSH="$omz_dir"
  export ZSH_CACHE_DIR="${ZLOAD_CACHE}/omz"
  mkdir -p "$ZSH_CACHE_DIR"

  if [[ -d "$omz_dir" ]]; then
    return 0
  fi

  mkdir -p "${omz_dir:h}"
  print -P "%F{cyan}zload:%f installing Oh-My-Zsh core..."
  command git clone --depth 1 https://github.com/ohmyzsh/ohmyzsh.git "$omz_dir" >/dev/null 2>&1
  local ret=$?

  if (( ret != 0 )); then
    print -u2 -P "%F{red}zload: failed to clone Oh-My-Zsh repository%f"
    rm -rf "$omz_dir"
    return $ret
  fi

  return 0
}

_zload_install_gh_r() {
  emulate -L zsh
  setopt null_glob extended_glob

  local in_var="$1"
  local -A _zspec
  _zspec=("${(@Pkv)in_var}")

  local dir="${_zspec[dir]}"
  local bin_dir="${dir}/bin"

  local -a existing
  existing=("$bin_dir"/*(N*x))
  ((${#existing} > 0)) && return 0

  local temp_dir="${dir}.tmp.$$"
  local stage="${temp_dir}/stage"
  mkdir -p "$temp_dir/extracted" "$stage"
  trap "rm -rf ${(q)temp_dir}" EXIT

  local owner_repo="${_zspec[spec]%%[@#]*}"
  local url="${_zspec[url]}"
  local asset_file="" want="${_zspec[sha256]}" target_url sum_url

  if [[ "$url" == file://* ]]; then
    asset_file="${temp_dir}/${url:t}"
    cp "${url#file://}" "$asset_file" || return 1
  else
    _zload_gh_r_asset "$owner_repo" "${_zspec[ref]}" || return 1
    target_url="${reply[1]}"
    sum_url="${reply[2]}"

    print -P "%F{14}zload%f  %F{11}downloading%f       %F{15}%B${target_url:t}%b%f%F{8}...%f"
    asset_file="${temp_dir}/${target_url:t}"
    command curl -fsSL "$target_url" -o "$asset_file" 2>/dev/null || {
      print -u2 -P "%F{9}zload: download failed for ${target_url}%f"
      return 1
    }

    if [[ -z "$want" && -n "$sum_url" ]]; then
      want="$(command curl -fsSL "$sum_url" 2>/dev/null)"
      want="${(L)${want%%[[:space:]]*}}"
    fi
  fi

  if [[ -n "$want" ]]; then
    _zload_sha256 "$asset_file"
    if [[ "$REPLY" != "$want" ]]; then
      print -u2 -P "%F{9}zload: checksum mismatch for ${asset_file:t}%f"
      return 1
    fi
  fi

  _zload_gh_r_unpack "$asset_file" "$temp_dir" "$stage" "${owner_repo:t}" || return 1

  rm -rf "$dir"
  mkdir -p "$dir"
  mv "$stage" "$bin_dir"
  return 0
}

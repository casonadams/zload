_zload_cmd_lock() {
  emulate -L zsh
  setopt null_glob

  local lock_file="${1:-${ZLOAD_DATA}/zload.lock}"
  mkdir -p "${lock_file:h}"

  local -a plugin_dirs
  plugin_dirs=("${ZLOAD_PLUGINS}"/*(N/))

  local -a lines
  lines+=("# zload lockfile")

  integer count=0
  local dir name commit
  for dir in "${plugin_dirs[@]}"; do
    name="${dir:t}"
    if [[ "$name" == "_snippets" ]]; then
      continue
    fi
    if [[ -d "$dir/.git" ]]; then
      commit="$(command git -C "$dir" rev-parse HEAD 2>/dev/null)"
      if [[ -n "$commit" ]]; then
        lines+=("${name}:${commit}")
        (( count++ ))
      fi
    fi
  done

  print -l "${lines[@]}" > "$lock_file"
  print -P "%F{10}zload%f  %F{10}✓ locked%f   %F{15}%B$count plugin(s)%b%f %F{8}to ${lock_file}%f"
  return 0
}

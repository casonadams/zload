_zload_cmd_lock() {
  emulate -L zsh
  setopt null_glob

  local lock_file="${1:-${ZLOAD_DATA}/zload.lock}"
  mkdir -p "${lock_file:h}"

  local -a plugin_dirs
  plugin_dirs=("${ZLOAD_PLUGINS}"/*(N/))

  local -a lines
  lines+=("# zload lockfile")

  integer count=0
  local dir
  for dir in "${plugin_dirs[@]}"; do
    local name="${dir:t}"
    if [[ -d "$dir/.git" ]]; then
      local commit
      commit="$(command git -C "$dir" rev-parse HEAD 2>/dev/null)"
      if [[ -n "$commit" ]]; then
        lines+=("${name}:${commit}")
        (( count++ ))
      fi
    fi
  done

  print -l "${lines[@]}" > "$lock_file"
  print -P "%F{green}zload: locked $count plugin(s) to %B${lock_file}%b%f"
  return 0
}

_zload_install() {
  emulate -L zsh

  local in_var="$1"
  local -A _zspec
  _zspec=("${(@Pkv)in_var}")

  local dir="${_zspec[dir]}"
  local type="${_zspec[type]}"
  local url="${_zspec[url]}"
  local ref="${_zspec[ref]}"

  if [[ -d "$dir" ]]; then
    return 0
  fi

  if [[ "$type" == "local" ]]; then
    print -u2 "zload: local plugin directory not found: $dir"
    return 1
  fi

  if [[ "$type" == "gh-r" ]]; then
    _zload_install_gh_r "$1"
    return $?
  fi

  if [[ "$type" == "snippet" ]]; then
    local target_file="${dir}/${_zspec[subpath]}"
    [[ -f "$target_file" ]] && return 0
    mkdir -p "$dir"
    local label="${_zspec[raw]:-${_zspec[spec]}}"
    print -P "%F{cyan}zload:%f fetching snippet %F{yellow}${label}%f..."
    if [[ "$url" == file://* ]]; then
      cp "${url#file://}" "$target_file"
    else
      command curl -fsSL "$url" -o "$target_file" >/dev/null 2>&1
    fi
    local ret=$?
    if (( ret != 0 )) || [[ ! -f "$target_file" ]]; then
      print -u2 -P "%F{red}zload: failed to fetch snippet ${url}%f"
      rm -rf "$dir"
      return 1
    fi
    zcompile -R "$target_file" 2>/dev/null
    return 0
  fi

  if [[ "$type" == "omz" ]]; then
    _zload_ensure_omz
    return $?
  fi

  mkdir -p "${dir:h}"

  local -a git_opts
  git_opts=(clone --depth 1)

  if [[ -n "$ref" ]]; then
    git_opts+=(-b "$ref")
  fi

  if [[ "$type" == "prezto" ]]; then
    git_opts+=(--recurse-submodules --shallow-submodules)
  fi

  local label="${_zspec[raw]:-${_zspec[spec]}}"
  print -P "%F{cyan}zload:%f installing %F{yellow}${label}%f..."
  command git "${git_opts[@]}" "$url" "$dir" >/dev/null 2>&1
  local ret=$?

  if (( ret != 0 )); then
    print -u2 -P "%F{red}zload: failed to clone ${url}%f"
    rm -rf "$dir"
    return $ret
  fi

  if [[ -n "${_zspec[build_cmd]}" ]]; then
    local build_dir="$dir"
    [[ -n "${_zspec[subpath]}" && -d "$dir/${_zspec[subpath]}" ]] && build_dir="$dir/${_zspec[subpath]}"
    print -P "%F{cyan}zload:%f running build hook %F{yellow}${_zspec[build_cmd]}%f..."
    ( cd "$build_dir" && eval "${_zspec[build_cmd]}" ) >/dev/null 2>&1
  fi

  return 0
}

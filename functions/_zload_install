_zload_install() {
  emulate -L zsh
  setopt extended_glob

  local in_var="$1"
  local -A _zspec
  _zspec=("${(@Pkv)in_var}")

  local dir="${_zspec[dir]}"
  local type="${_zspec[type]}"
  local url="${_zspec[url]}"
  local ref="${_zspec[ref]}"

  if [[ "$type" == "omz" ]]; then
    _zload_ensure_omz
    return $?
  fi

  if [[ "$type" == "gh-r" ]]; then
    _zload_install_gh_r "$1"
    return $?
  fi

  if [[ -d "$dir" ]]; then
    return 0
  fi

  if [[ "$type" == "local" ]]; then
    print -u2 -P "%F{9}zload: local plugin directory not found: $dir%f"
    return 1
  fi

  if [[ "$type" == "snippet" ]]; then
    local target_file="${dir}/${_zspec[subpath]}"
    [[ -f "$target_file" ]] && return 0
    local label="${_zspec[raw]:-${_zspec[spec]}}"
    print -P "%F{14}zload%f  %F{11}fetching snippet%f  %F{15}%B${label}%b%f%F{8}...%f"
    _zload_fetch_snippet "$url" "$target_file" "${_zspec[sha256]}" && return 0
    rm -rf "$dir"
    return 1
  fi

  mkdir -p "${dir:h}"

  local -a git_opts
  git_opts=(clone --depth 1)

  if [[ -n "$ref" ]]; then
    git_opts+=(-b "$ref")
  fi

  if [[ "$type" == "prezto" ]]; then
    git_opts+=(--recurse-submodules --shallow-submodules)
  fi

  local label="${_zspec[raw]:-${_zspec[spec]}}"
  local out
  print -P "%F{14}zload%f  %F{11}installing%f        %F{15}%B${label}%b%f%F{8}...%f"
  out="$(command git "${git_opts[@]}" "$url" "$dir" 2>&1)"
  local ret=$?

  # `git clone -b` rejects commit SHAs; fetch the commit, or everything for abbreviated SHAs.
  if ((ret != 0)) && [[ "$ref" == [0-9a-f](#c7,40) ]]; then
    rm -rf "$dir"
    out="$(command git init -q "$dir" 2>&1 &&
      command git -C "$dir" remote add origin "$url" 2>&1 &&
      { command git -C "$dir" fetch -q --depth 1 origin "$ref" 2>&1 && command git -C "$dir" checkout -q FETCH_HEAD 2>&1 ||
        { command git -C "$dir" fetch -q origin 2>&1 && command git -C "$dir" checkout -q "$ref" 2>&1; }; })"
    ret=$?
  fi

  if ((ret != 0)); then
    print -u2 -P "%F{9}zload: failed to clone ${url}%f"
    [[ -n "$out" ]] && print -u2 -r -- "  ${out//$'\n'/$'\n'  }"
    rm -rf "$dir"
    return $ret
  fi

  if [[ -n "${_zspec[build_cmd]}" ]]; then
    print -P "%F{14}zload%f  %F{11}building%f          %F{15}%B${label}%b%f %F{8}(${_zspec[build_cmd]})%f"
    if ! _zload_run_build "$dir" "${_zspec[subpath]}" "${_zspec[build_cmd]}" "$label"; then
      rm -rf "$dir"
      return 1
    fi
  fi

  return 0
}

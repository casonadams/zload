_zload_write_bundle() {
  emulate -L zsh
  setopt extended_glob

  local slot="$1"
  shift
  local -a specs=("$@")
  ((${#specs} == 0)) && return 0

  local -a sorted_specs
  _zload_sort_plugins sorted_specs "${specs[@]}"

  local sfx=""
  ((slot > 1)) && sfx=".${slot}"
  local bundle="${ZLOAD_CACHE}/bundle${sfx}.zsh"
  local bundle_tmp="${bundle}.tmp.$$"
  local hash_file="${ZLOAD_CACHE}/bundle${sfx}.hash"
  local hash_tmp="${hash_file}.tmp.$$"
  local lock_dir="${ZLOAD_CACHE}/.compile.lock"
  local key="${_zload_call_keys[$slot]:-${(j: :)specs}}"

  integer attempts=0
  while ! mkdir "$lock_dir" 2>/dev/null; do
    ((attempts++))
    if ((attempts > 20)); then
      rm -rf "$lock_dir" 2>/dev/null
      break
    fi
    sleep 0.1
  done

  local -a all_fpaths all_paths body deferred_specs fps
  local -A omz_emitted
  local spec_entry target_dir bin_dir fp lib omz_lib script
  local -A parsed info
  local -A libfile=(git git.zsh theme theme-and-appearance.zsh termsupport termsupport.zsh)
  integer has_omz=0

  [[ -d "$HOME/.zfunc" ]] && all_fpaths+=("$HOME/.zfunc")

  omz_lib="${ZLOAD_PLUGINS}/_omz/lib"
  [[ ! -d "$omz_lib" && -d "${ZSH}/lib" ]] && omz_lib="${ZSH}/lib"

  for spec_entry in "${sorted_specs[@]}"; do
    _zload_parse_spec parsed "$spec_entry"

    _zload_resolve_plugin parsed info
    target_dir="${info[target]}"
    script="${info[script]}"

    if [[ -n "${info[fpath]}" ]]; then
      fps=("${(s.:.)info[fpath]}")
      for fp in "${fps[@]}"; do
        ((${all_fpaths[(Ie)$fp]})) || all_fpaths+=("$fp")
      done
    fi

    bin_dir="${info[bin]}"
    [[ -n "${parsed[bin]}" ]] && bin_dir="${parsed[dir]}/${parsed[bin]}"
    if [[ -n "$bin_dir" && -d "$bin_dir" ]]; then
      ((${all_paths[(Ie)$bin_dir]})) || all_paths+=("$bin_dir")
    fi

    [[ "${parsed[type]}" == "omz" ]] && has_omz=1

    if [[ "${parsed[type]}" == "prezto" && -d "$target_dir/functions" ]]; then
      fps=("$target_dir/functions"/*(N:t))
      if ((${#fps} > 0)); then
        body+=("fpath=(${(q)target_dir}/functions \"\${fpath[@]}\")")
        body+=("autoload -Uz ${(j: :)fps}")
      fi
    fi

    if [[ -n "${parsed[on_cmds]}" ]]; then
      _zload_create_stub "${parsed[on_cmds]}" "$script" "${parsed[type]}" "${parsed[subpath]}" --emit
      body+=("$REPLY")
      continue
    fi

    if [[ -n "${parsed[on_dir]}" ]]; then
      body+=("_zload_schedule_on_dir ${(q)spec_entry} ${(q)parsed[on_dir]}")
      continue
    fi

    if ((parsed[defer])); then
      deferred_specs+=("$spec_entry")
      continue
    fi

    if [[ "${parsed[type]}" == "omz" && -d "$omz_lib" ]]; then
      _zload_omz_libs "${parsed[subpath]}" "$script"
      for lib in "${reply[@]}"; do
        ((${+omz_emitted[$lib]})) && continue
        [[ -f "$omz_lib/${libfile[$lib]}" ]] || continue
        omz_emitted[$lib]=1
        body+=("source ${(q)omz_lib}/${libfile[$lib]}")
        body+=("_zload_omz_loaded_libs[$lib]=1")
      done
    fi

    if [[ -n "$script" && -f "$script" ]]; then
      [[ -f "${script}.zwc" && "${script}.zwc" -nt "$script" ]] || zcompile -R "$script" 2>/dev/null
      body+=("[[ -f ${(q)script} ]] && source ${(q)script}")
    fi
  done

  {
    print -r -- "# Compiled by zload"
    print -r -- "typeset -g _zload_bundle_loaded=1"
    print -r -- "typeset -g ZLOAD_HOME=${(q)ZLOAD_HOME}"
    print -r -- "typeset -g ZLOAD_DATA=${(q)ZLOAD_DATA}"
    print -r -- "typeset -g ZLOAD_CACHE=${(q)ZLOAD_CACHE}"
    print -r -- "typeset -g ZLOAD_PLUGINS=${(q)ZLOAD_PLUGINS}"
    print -r -- "typeset -g -U -a _zload_specs"
    print -r -- "typeset -g -A _zload_call_entries _zload_call_keys"
    print -r -- "_zload_specs+=(${(q)specs[@]})"
    print -r -- "_zload_call_entries[${slot}]=${(qq)${(F)specs}}"
    print -r -- "_zload_call_keys[${slot}]=${(qq)key}"
    print -r -- "(( \${fpath[(Ie)\$ZLOAD_HOME/functions]} )) || fpath=(\"\$ZLOAD_HOME/functions\" \"\${fpath[@]}\")"

    for fp in "${all_fpaths[@]}"; do
      print -r -- "(( \${fpath[(Ie)${(q)fp}]} )) || fpath=(${(q)fp} \"\${fpath[@]}\")"
    done

    for bin_dir in "${all_paths[@]}"; do
      print -r -- "(( \${path[(Ie)${(q)bin_dir}]} )) || path=(${(q)bin_dir} \"\${path[@]}\")"
    done

    if ((has_omz)); then
      print -r -- "export ZSH=${(q)ZLOAD_PLUGINS}/_omz"
      print -r -- "export ZSH_CACHE_DIR=${(q)ZLOAD_CACHE}/omz"
      print -r -- "[[ -d \"\$ZSH_CACHE_DIR\" ]] || mkdir -p \"\$ZSH_CACHE_DIR\""
      print -r -- "typeset -g -A _zload_omz_loaded_libs"
      print -r -- "autoload -Uz _zload_omz_shim"
    fi

    ((${#body} > 0)) && print -r -- "${(F)body}"

    ((${#deferred_specs} > 0)) && print -r -- "_zload_schedule_deferred ${(q)deferred_specs[@]}"

    print -r -- "if (( ! \${+ZLOAD_NO_COMPINIT} )) && [[ -o interactive ]] && (( ! \${_zload_compinit_done:-0} )); then"
    print -r -- "  autoload -Uz _zload_setup_lazy_compinit"
    print -r -- "  _zload_setup_lazy_compinit"
    print -r -- "fi"
  } >"$bundle_tmp"

  # A cached completion dump predates any fpath change introduced by this bundle.
  if [[ ! -f "$bundle" ]] || [[ "$(<"$bundle")" != "$(<"$bundle_tmp")" ]]; then
    rm -f "${ZLOAD_CACHE}"/zcompdump*(N)
  fi

  # The .zwc must be built under the final name; zsh ignores it otherwise.
  rm -f "$hash_file" "${bundle}.zwc"
  mv -f "$bundle_tmp" "$bundle"
  zcompile -R "$bundle" 2>/dev/null

  print -r -- "$key" >"$hash_tmp"
  mv -f "$hash_tmp" "$hash_file"

  rm -rf "$lock_dir" 2>/dev/null
  return 0
}

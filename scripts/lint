#!/usr/bin/env zsh
emulate -L zsh
setopt extended_glob

cd "${0:A:h:h}" || exit 1

local mode="run"
local -i json_mode=0
local -i fix_mode=0

while (($# > 0)); do
  case "$1" in
    -f | --fix)
      fix_mode=1
      shift
      ;;
    -j | --json)
      json_mode=1
      shift
      ;;
    -h | --help)
      print -P "%F{14}%Bzload lint%b%f - Code quality, style, and complexity gates"
      print ""
      print "Usage: ./scripts/lint [options]"
      print ""
      print "Options:"
      print "  -f, --fix    Automatically reformat code with shfmt -w"
      print "  -j, --json   Output results as structured JSON"
      print "  -h, --help   Show this help message"
      exit 0
      ;;
    *)
      print -u2 -P "%F{9}Unknown option: $1%f"
      exit 1
      ;;
  esac
done

local -i errors=0
local -i warnings=0

# Define source file collections
local -a core_files function_files test_files all_shfmt_files
core_files=(zload.zsh zload.plugin.zsh(N))
function_files=(functions/*~*.zwc(N))
test_files=(test/*.zsh(N) benchmark/*.zsh(N) spec/*.sh(N))
all_shfmt_files=("${core_files[@]}" "${function_files[@]}" "${test_files[@]}" scripts/*(N))

local f fn line res_status name file cx ccx loc crap color naked_lines table_data
local -a syntax_failures autoload_failures format_failures

# -----------------------------------------------------------------------------
# 1. Syntax Check (zsh -n)
# -----------------------------------------------------------------------------
if ((json_mode == 0)); then
  print -P "%F{14}%B[1/7] Syntax validation (zsh -n)...%b%f"
fi

for f in "${core_files[@]}" "${function_files[@]}" "${test_files[@]}" scripts/*(N); do
  [[ -f "$f" ]] || continue
  if ! zsh -n "$f" 2>&1; then
    syntax_failures+=("$f")
    ((errors++))
  fi
done

if ((json_mode == 0)); then
  if ((${#syntax_failures} == 0)); then
    print -P "  %F{10}✓%f %F{15}All source files have valid Zsh syntax.%f"
  else
    for f in "${syntax_failures[@]}"; do
      print -P "  %F{9}✗%f Syntax error in: %F{15}%B$f%b%f"
    done
  fi
  print ""
fi

# -----------------------------------------------------------------------------
# 2. Autoload Function Cleanliness Check
# -----------------------------------------------------------------------------
if ((json_mode == 0)); then
  print -P "%F{14}%B[2/7] Autoload encapsulation check...%b%f"
fi

for f in "${function_files[@]}"; do
  [[ -f "$f" ]] || continue
  fn="${f:t}"
  naked_lines=$(awk -v fname="$fn" '
    /^[[:space:]]*(#|$)/ { next }
    depth == 0 {
      if ($0 ~ /^[a-zA-Z0-9_-]+[[:space:]]*\(\)[[:space:]]*\{?/ || $0 ~ /^function[[:space:]]+/) {
        # function header
      } else if ($0 ~ ("^[[:space:]]*" fname "([[:space:]]+.*)?$")) {
        # allowed self-invocation
      } else {
        print FILENAME ":" NR ": " $0
      }
    }
    {
      for (i=1; i<=length($0); i++) {
        c = substr($0, i, 1)
        if (c == "{") depth++
        else if (c == "}") depth--
      }
    }
  ' "$f")
  if [[ -n "$naked_lines" ]]; then
    autoload_failures+=("$naked_lines")
    ((errors++))
  fi
done

if ((json_mode == 0)); then
  if ((${#autoload_failures} == 0)); then
    print -P "  %F{10}✓%f %F{15}Autoload functions cleanly encapsulated (zero naked statements).%f"
  else
    for line in "${autoload_failures[@]}"; do
      print -P "  %F{9}✗%f Unencapsulated top-level code: %F{15}$line%f"
    done
  fi
  print ""
fi

# -----------------------------------------------------------------------------
# 3. Formatting Check (shfmt -ln zsh)
# -----------------------------------------------------------------------------
if ((json_mode == 0)); then
  print -P "%F{14}%B[3/7] Formatting check (shfmt)...%b%f"
fi

local -i shfmt_available=0
if (($+commands[shfmt])); then
  if ! shfmt -help 2>&1 | grep -q "zsh"; then
    if ((json_mode == 0)); then
      print -P "  %F{11}⚠ shfmt lacks -ln zsh dialect support (upgrade to >= 3.10).%f"
    fi
  else
    shfmt_available=1
    if ((fix_mode)); then
      shfmt -w -i 2 -ci -ln zsh "${all_shfmt_files[@]}"
      if ((json_mode == 0)); then
        print -P "  %F{10}✓%f %F{15}Reformatted files in-place with shfmt.%f"
      fi
    else
      local shfmt_diff
      shfmt_diff=$(shfmt -d -i 2 -ci -ln zsh "${all_shfmt_files[@]}" 2>&1)
      if [[ -n "$shfmt_diff" ]]; then
        ((errors++))
        if ((json_mode == 0)); then
          print -P "  %F{9}✗%f %F{15}Formatting issues detected. Run %F{14}./scripts/lint --fix%f%F{15} to format.%f"
          print -r -- "$shfmt_diff" | head -n 20
        fi
      else
        if ((json_mode == 0)); then
          print -P "  %F{10}✓%f %F{15}Code adheres to standard Zsh formatting.%f"
        fi
      fi
    fi
  fi
else
  if ((json_mode == 0)); then
    print -P "  %F{11}⚠ shfmt not found on PATH.%f"
  fi
fi

if ((json_mode == 0)); then
  print ""
fi

# -----------------------------------------------------------------------------
# Prepare Staged Hardlink Shadow Tree for Ripwire
# -----------------------------------------------------------------------------
local stage_dir
local -i ripwire_available=0
local metrics_json=""

if (($+commands[ripwire])); then
  ripwire_available=1
  stage_dir=$(mktemp -d)
  trap 'rm -rf "$stage_dir"' EXIT INT TERM

  for f in "${function_files[@]}"; do
    [[ -f "$f" ]] && (ln "$PWD/$f" "$stage_dir/${f:t}.zsh" 2>/dev/null || cp "$PWD/$f" "$stage_dir/${f:t}.zsh")
  done
  for f in "${core_files[@]}"; do
    [[ -f "$f" ]] && (ln "$PWD/$f" "$stage_dir/${f:t}" 2>/dev/null || cp "$PWD/$f" "$stage_dir/${f:t}")
  done
fi

# -----------------------------------------------------------------------------
# 4. Complexity & CRAP Quality Gate (ripwire --metrics)
# -----------------------------------------------------------------------------
local -i qg_failed=0
local -i qg_warn=0
local metrics_summary="[]"

if ((ripwire_available)); then
  if ((json_mode == 0)); then
    print -P "%F{14}%B[4/7] Complexity & CRAP Quality Gate (ripwire)...%b%f"
  fi

  metrics_json=$(ripwire "$stage_dir" --metrics --json 2>/dev/null)

  if (($+commands[jq])) && [[ -n "$metrics_json" ]]; then
    metrics_summary=$(print -r -- "$metrics_json" | jq '[
      .r[] as $file | $file.s[]? | select(.t == "fn" and .n != "TRAPINT") | {
        function: .n,
        file: ($file.p | rtrimstr(".zsh")),
        cyclomatic: .cx,
        cognitive: .ccx,
        loc: .loc,
        crap: (((.cx * .cx * 0.008) + .cx) * 10 | round / 10),
        status: (if .ccx > 30 or .cx > 25 or (((.cx * .cx * 0.008) + .cx) > 30) then "FAIL" elif .ccx > 15 or .cx > 15 then "WARN" else "PASS" end)
      }
    ] | sort_by(.cognitive) | reverse')

    if ((json_mode == 0)); then
      printf "  \033[1m%-32s %-24s %-5s %-5s %-6s %s\033[0m\n" "Function" "File" "cx" "ccx" "CRAP" "Status"
      print -P "  %F{8}----------------------------------------------------------------------------%f"

      table_data=$(print -r -- "$metrics_summary" | jq -r '.[] | "\(.status)\t\(.function)\t\(.file)\t\(.cyclomatic)\t\(.cognitive)\t\(.crap)"')

      while IFS=$'\t' read -r res_status name file cx ccx crap; do
        [[ -z "$name" ]] && continue
        if [[ "$res_status" == "FAIL" ]]; then
          color="\033[31m"
          ((qg_failed++))
        elif [[ "$res_status" == "WARN" ]]; then
          color="\033[33m"
          ((qg_warn++))
        else
          color="\033[32m"
        fi
        printf "  %-32s %-24s %-5s %-5s %-6s ${color}%s\033[0m\n" "$name" "$file" "$cx" "$ccx" "$crap" "$res_status"
      done <<<"$table_data"

      print -P "  %F{8}----------------------------------------------------------------------------%f"
      if ((qg_failed > 0)); then
        print -P "  %F{9}✗ Quality gate failed: $qg_failed function(s) exceed complexity limits.%f"
        ((errors += qg_failed))
      else
        print -P "  %F{10}✓%f %F{15}All functions within complexity and CRAP limits.%f %F{8}($qg_warn warnings)%f"
      fi
      print ""
    fi
  fi
else
  if ((json_mode == 0)); then
    print -P "%F{14}%B[4/7] Complexity & CRAP Quality Gate (ripwire)...%b%f"
    print -P "  %F{11}⚠ ripwire not found on PATH.%f\n"
  fi
fi

# -----------------------------------------------------------------------------
# 5. Clones & Duplication Audit (ripwire --clones)
# -----------------------------------------------------------------------------
local -i clone_groups=0
if ((ripwire_available)); then
  if ((json_mode == 0)); then
    print -P "%F{14}%B[5/7] Code duplication & clones audit (ripwire)...%b%f"
  fi

  local clones_out
  clones_out=$(ripwire "$stage_dir" --clones 2>/dev/null)
  local non_exempt_clones
  non_exempt_clones=$(print -r -- "$clones_out" | tr '>' '\n' | grep -E '^<group type' | grep -v 'exempt=' || true)

  if [[ -n "$non_exempt_clones" ]]; then
    clone_groups=$(print -r -- "$non_exempt_clones" | grep -c '^<group type' || echo "0")
    ((errors += clone_groups))
    if ((json_mode == 0)); then
      print -P "  %F{9}✗ Duplicate code clones detected ($clone_groups group(s)):%f"
      print -r -- "$clones_out" | sed -E 's/<!--.*-->//g' | tr '>' '\n' | grep -E '^<f n=' | sed -E 's/.*n="([^"]*)".*p="([^"]*)".*/    - \1 (\2)/'
    fi
  else
    if ((json_mode == 0)); then
      print -P "  %F{10}✓%f %F{15}Zero non-exempt code clones detected.%f"
    fi
  fi

  if ((json_mode == 0)); then
    print ""
  fi
fi

# -----------------------------------------------------------------------------
# 6. Dead Code Audit (ripwire --dead-code)
# -----------------------------------------------------------------------------
local -i dead_count=0
if ((ripwire_available)); then
  if ((json_mode == 0)); then
    print -P "%F{14}%B[6/7] Dead code audit (ripwire)...%b%f"
  fi

  local dc_out
  dc_out=$(ripwire "$stage_dir" --dead-code 2>/dev/null)
  dead_count=$(print -r -- "$dc_out" | grep -oE 'count="[0-9]+"' | head -n 1 | cut -d '"' -f 2 || echo "0")

  if ((dead_count > 0)); then
    ((errors += dead_count))
    if ((json_mode == 0)); then
      print -P "  %F{9}✗ $dead_count unreferenced function(s) detected.%f"
    fi
  else
    if ((json_mode == 0)); then
      print -P "  %F{10}✓%f %F{15}Zero dead code functions detected.%f"
    fi
  fi

  if ((json_mode == 0)); then
    print ""
  fi
fi

# -----------------------------------------------------------------------------
# 7. Documentation Drift & Quality Delta Gates (ripwire)
# -----------------------------------------------------------------------------
local -i drift_count=0
local -i delta_gating=0
local -i delta_regressions=0

if ((ripwire_available)); then
  if ((json_mode == 0)); then
    print -P "%F{14}%B[7/7] Documentation drift & quality regressions (ripwire)...%b%f"
  fi

  local dd_out
  dd_out=$(ripwire . --doc-drift 2>/dev/null)
  drift_count=$(print -r -- "$dd_out" | grep -oE 'drift="[0-9]+"' | head -n 1 | cut -d '"' -f 2 || echo "0")

  if ((drift_count > 0)); then
    ((errors += drift_count))
    if ((json_mode == 0)); then
      print -P "  %F{9}✗ $drift_count drifted documentation claim(s) detected.%f"
    fi
  else
    if ((json_mode == 0)); then
      print -P "  %F{10}✓%f %F{15}Documentation anchors verified (zero drift).%f"
    fi
  fi

  local qd_json
  qd_json=$(ripwire . --quality-delta --json 2>/dev/null)
  if [[ -n "$qd_json" ]] && (($+commands[jq])); then
    delta_gating=$(print -r -- "$qd_json" | jq -r '.gating // 0')
    delta_regressions=$(print -r -- "$qd_json" | jq -r '.regressions // 0')
    if ((delta_gating > 0)); then
      ((errors += delta_gating))
      if ((json_mode == 0)); then
        print -P "  %F{9}✗ $delta_gating gating quality regression(s) vs git HEAD.%f"
      fi
    else
      if ((json_mode == 0)); then
        print -P "  %F{10}✓%f %F{15}Zero quality regressions vs git HEAD.%f"
      fi
    fi
  fi

  if ((json_mode == 0)); then
    print ""
  fi
fi

# -----------------------------------------------------------------------------
# Clean up Ripwire staging directory
# -----------------------------------------------------------------------------
if [[ -n "$stage_dir" && -d "$stage_dir" ]]; then
  rm -rf "$stage_dir"
fi

# -----------------------------------------------------------------------------
# Summary & Output
# -----------------------------------------------------------------------------
if ((json_mode == 1)); then
  local is_passed="true"
  ((errors > 0)) && is_passed="false"
  local syntax_json="[]"
  ((${#syntax_failures} > 0)) && syntax_json=$(printf '%s\n' "${syntax_failures[@]}" | jq -R . | jq -s .)
  local autoload_json="[]"
  ((${#autoload_failures} > 0)) && autoload_json=$(printf '%s\n' "${autoload_failures[@]}" | jq -R . | jq -s .)

  jq -n \
    --argjson passed "$is_passed" \
    --argjson errors "$errors" \
    --argjson warnings "$warnings" \
    --argjson syntax_failures "$syntax_json" \
    --argjson autoload_failures "$autoload_json" \
    --argjson clone_groups "$clone_groups" \
    --argjson dead_count "$dead_count" \
    --argjson drift_count "$drift_count" \
    --argjson delta_gating "$delta_gating" \
    --argjson delta_regressions "$delta_regressions" \
    --argjson metrics "$metrics_summary" \
    '{
      passed: $passed,
      errors: $errors,
      warnings: $warnings,
      checks: {
        syntax_errors: $syntax_failures,
        autoload_violations: $autoload_failures,
        clone_groups: $clone_groups,
        dead_functions: $dead_count,
        doc_drift: $drift_count,
        quality_delta: {
          gating: $delta_gating,
          regressions: $delta_regressions
        }
      },
      metrics: $metrics
    }'
  exit $errors
fi

print -P "%F{8}============================================================================%f"
if ((errors == 0)); then
  print -P "%F{10}%BAll lint and quality checks passed!%b%f"
  exit 0
else
  print -P "%F{9}%BLint failed with $errors error(s).%b%f"
  exit 1
fi
